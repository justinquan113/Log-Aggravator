CC = gcc
CFLAGS = -Wall -Wextra -Wpedantic -g -O0 -std=gnu11 -pthread -I./include
CLIENT = src/logctl/logctl.c
SERVER = src/logctl/testcontrol.c
LOGGEN = src/loggen/gen.c

all: logctl daemon loggen

logctl:
	$(CC) $(CFLAGS) $(CLIENT) -o logctl

daemon:
	$(CC) $(CFLAGS) $(SERVER) -o daemon

loggen:
	$(CC) $(CFLAGS) $(LOGGEN) -o loggen

clean:
	rm -f logctl daemon loggen

.PHONY: all clean logctl daemon loggen